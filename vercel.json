{
  "framework": null,
  "installCommand": "echo 'static site - no install needed'",
  "buildCommand": "echo 'static site - no build'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(sitemap|sitemap-1|sitemap-2|sitemap-index).xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/sitemap-1.xml", "destination": "/sitemap-1.xml" },
    { "source": "/sitemap-2.xml", "destination": "/sitemap-2.xml" },
    { "source": "/sitemap-index.xml", "destination": "/sitemap-index.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/favicon-32x32.png", "destination": "/favicon-32x32.png" },
    { "source": "/favicon-48x48.png", "destination": "/favicon-48x48.png" },
    { "source": "/favicon-192x192.png", "destination": "/favicon-192x192.png" },
    { "source": "/apple-touch-icon.png", "destination": "/apple-touch-icon.png" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
